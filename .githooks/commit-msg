#!/usr/bin/env zsh
# commit-msg: enforce "<type>(<scope>): <summary>" on the first line.
# History cannot be edited retroactively, so the format is checked at the door.
set -u
subject=$(head -n1 "$1")

# messages generated by git itself
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='feat|fix|perf|refactor|test|docs|build|ci|chore|style|bench|revert'
if ! print -r -- "$subject" | grep -qE "^(${types})(\([a-z0-9-]+\))?!?: [^ ].{0,71}\$"; then
  print -u2 "✗ invalid commit subject: $subject"
  print -u2 "  format : <type>(<scope>): <summary>   (summary <= 72 chars, English)"
  print -u2 "  types  : ${types//|/ }"
  print -u2 "  example: feat(core): add strided tensor view"
  exit 1
fi
exit 0
